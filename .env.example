# App Admin Password (used to unlock the /admin panel)
APP_ADMIN_PASSWORD=

# Gemini API
GEMINI_API_KEY=

# Instagram Feed Graph API token (optional)
VITE_INSTAGRAM_ACCESS_TOKEN=

# Firebase Configuration
# Option A: Paste entire service account JSON into FIREBASE_SERVICE_ACCOUNT (recommended for Vercel)
FIREBASE_SERVICE_ACCOUNT=

# Option B: Individual credentials
FIREBASE_PROJECT_ID=isg-initiative
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_FEED_COLLECTION=instagramFeed

# Option C: Local file path
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json