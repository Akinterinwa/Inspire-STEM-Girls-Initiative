{
  "rewrites": [
    { "source": "/api/admin/login", "destination": "/api/admin/login.js" },
    { "source": "/api/admin/logout", "destination": "/api/admin/logout.js" },
    { "source": "/api/instagram-feed", "destination": "/api/instagram-feed.js" },
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
